@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix lifecycle: <https://rdf-vocabulary.ddialliance.org/lifecycle#>.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sssom: <https://w3id.org/sssom/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Questions:
# - record_id useful?
# - review?
# - curation_rule for describing how to go from a class to another (see contactPoint)?

# --- Mapping sets --- #

<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/catalog> a sssom:MappingSet ;
  dcterms:description "Mapping DDI Lifecycle elements to DCAT-AP dataset";
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;  # Adapt license
  sssom:mapping_provider <https://github.com/Making-Sense-Info/Dedicate/> ;
  sssom:mappings (
  # Catalog mandatory properties
  <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/catalog/orgname-to-title>
  <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/catalog/orgname-to-description>
  <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/catalog/org-to-publisher>
  ) .

<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset> a sssom:MappingSet ;
  dcterms:description "Mapping DDI Lifecycle elements to DCAT-AP dataset";
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;  # Adapt license
  sssom:mapping_provider <https://github.com/Making-Sense-Info/Dedicate/> ;
  sssom:mappings (
  # Dataset mandatory and recommended properties
  <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/title-to-title>
  <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/description-to-description>
  <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/contactinformation-to-contactpoint>
  <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/keyword-to-keyword>
  <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/keyword-to-theme>
  ) .

<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/distribution> a sssom:MappingSet ;
  dcterms:description "Mapping DDI Lifecycle elements to DCAT-AP distribution";
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;  # Adapt license
  sssom:mapping_provider <https://github.com/Making-Sense-Info/Dedicate/> ;
  sssom:mappings (
  # Distribution mandatory  and recommended properties
  <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/distribution/datafileuri-to-accessurl>
  <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/distribution/description-to-description>
  <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/distribution/format-to-format>
  ) .


# --- Mappings --- #

# Catalog
# They are only stubs for now

<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/catalog/orgname-to-title>
  a owl:Axiom .

<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/catalog/orgname-to-description>
  a owl:Axiom .

<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/catalog/org-to-publisher>
  a owl:Axiom .

# Dataset

<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/title-to-title>
    a owl:Axiom ;
    sssom:record_id <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/title-to-title> ; # To be validated
    pav:authoredBy "<http://id.making-sense.info/romain>"; # Level-up? Use MS?
    dcterms:created "2026-10-14"^^xsd:date;
    owl:annotatedProperty owl:equivalentClass; # https://www.w3.org/TR/owl-ref/#equivalentClass-def
    owl:annotatedSource lifecycle:title;
    owl:annotatedTarget dcterms:title;
    sssom:confidence 0.9; # TODO
    sssom:mapping_justification semapv:ManualMappingCuration;
    sssom:subject_label "Title"@en; # https://docs.ddialliance.org/DDI-Lifecycle/dev/output/lifecycle40.ttl
    sssom:object_label "Title";
    sssom:see_also <https://github.com/Making-Sense-Info/Dedicate/blob/main/model-mapping.md#dcattitle> ; # 🤔
    sssom:comment "We are mapping the `StudyUnit/Citation/Title` of DDI Lifecycle to the DC Terms `title` used in DCAT-AP" .

<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/description-to-description>  a owl:Axiom;
    sssom:record_id <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/description-to-description> ;
    pav:authoredBy "<http://id.making-sense.info/romain>";
    dcterms:created "2026-10-14"^^xsd:date;
    owl:annotatedProperty owl:equivalentClass;
    owl:annotatedSource lifecycle:description;
    owl:annotatedTarget dcterms:description;
    sssom:confidence 0.9;
    sssom:mapping_justification semapv:ManualMappingCuration;
    sssom:subject_label "Description"@en;
    sssom:object_label "Description";
    sssom:see_also <https://github.com/Making-Sense-Info/Dedicate/blob/main/model-mapping.md#dctdescription> ;
    sssom:comment "We are mapping the `StudyUnit/Citation/Description` of DDI Lifecycle to the DC Terms `description` used in DCAT-AP" .

  # https://github.com/Making-Sense-Info/Mekong/blob/main/cataloging/example.ttl#L22C43-L22C55


<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/contactinformation-to-contactpoint>    a owl:Axiom;
    sssom:record_id <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/contactinformation-to-contactpoint> ;
    pav:authoredBy "<http://id.making-sense.info/romain>";
    dcterms:created "2026-10-14"^^xsd:date;
    owl:annotatedProperty owl:equivalentClass;
    owl:annotatedSource lifecycle:contactInformation;
    owl:annotatedTarget dcat:contactPoint;
    sssom:confidence 0.8;
    sssom:mapping_justification semapv:ManualMappingCuration;
    sssom:subject_label "ContactInformation"@en;
    sssom:object_label "contact point"; # ❗️
    sssom:see_also <https://github.com/Making-Sense-Info/Dedicate/blob/main/model-mapping.md#dcatcontactpoint> ;
    sssom:comment "Using here the `ContactInformation` of an Organization" .


<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/keyword-to-keyword>    a owl:Axiom;
    sssom:record_id <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/keyword-to-keyword> ;
    pav:authoredBy "<http://id.making-sense.info/romain>";
    dcterms:created "2026-10-14"^^xsd:date;
    owl:annotatedProperty owl:equivalentClass;
    owl:annotatedSource lifecycle:keyword;
    owl:annotatedTarget dcat:keyword;
    sssom:confidence 1.0;
    sssom:mapping_justification semapv:ManualMappingCuration;
    sssom:subject_label "Keyword"@en;
    sssom:object_label "keyword";
    sssom:see_also <https://github.com/Making-Sense-Info/Dedicate/blob/main/model-mapping.md#dcatkeyword> ;
    sssom:see_also <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/keyword-to-theme> ;
    sssom:comment "The `StudyUnit/Coverage/TopicalCoverage/Keyword` maps to dcat:keyword when its value/range is a string" .


<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/keyword-to-theme>    a owl:Axiom;
    sssom:record_id <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/keyword-to-theme> ;
    pav:authoredBy "<http://id.making-sense.info/romain>";
    dcterms:created "2026-10-14"^^xsd:date;
    owl:annotatedProperty owl:equivalentClass;
    owl:annotatedSource lifecycle:keyword;
    owl:annotatedTarget dcat:theme;
    sssom:confidence 1.0;
    sssom:mapping_justification semapv:ManualMappingCuration;
    sssom:subject_label "Keyword"@en;
    sssom:object_label "keyword";
    sssom:object_category <http://publications.europa.eu/resource/authority/data-theme/HEAL> ; # ❗️To be validated
    sssom:see_also <https://github.com/Making-Sense-Info/Dedicate/blob/main/model-mapping.md#dcatkeyword> ;
    sssom:see_also <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/keyword-to-keyword> ;
    sssom:comment "The `StudyUnit/Coverage/TopicalCoverage/Keyword` maps to `dcat:theme` when it contains a controlled vocabulary URI" .

# Distribution

<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/distribution/datafileuri-to-accessurl>
  a owl:Axiom ;
  sssom:record_id <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/distribution/datafileuri-to-accessurl> ;
  dcterms:created "2026-10-19"^^xsd:date;
  owl:annotatedProperty owl:equivalentClass;
  owl:annotatedSource lifecycle:dataFileUri;
  owl:annotatedTarget dcat:accessURL;
  sssom:confidence 0.9;
  sssom:mapping_justification semapv:ManualMappingCuration;
  sssom:subject_label "DataFileURI"@en;
  sssom:object_label "access address"@en ;
  sssom:see_also <https://github.com/Making-Sense-Info/Dedicate/blob/main/model-mapping.md#dcataccessurl> ;
  sssom:comment "The `PhysicalInstance/DataFileIdentification/DataFileURI` maps to `dcat:accessURL" .

<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/distribution/description-to-description>
  a owl:Axiom ;
  sssom:record_id <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/distribution/description-to-description> ;
  dcterms:created "2026-10-19"^^xsd:date ;
  owl:annotatedProperty owl:equivalentClass ;
  owl:annotatedSource dcterms:description ; # ???
  owl:annotatedTarget dcterms:description ;
  sssom:confidence 0.9;
  sssom:mapping_justification semapv:ManualMappingCuration;
  sssom:subject_label "Description"@en;
  sssom:object_label "Description" ;
  sssom:see_also <https://github.com/Making-Sense-Info/Dedicate/blob/main/model-mapping.md#dctdescription-1> ;
  sssom:see_also <https://docs.ddialliance.org/DDI-Lifecycle/3.3/xmlschema/schemas/dc_xsd/elements/any.html> ;
  sssom:comment "The `PhysicalInstance/Citation/description` maps to `dcterms:description" .

<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/distribution/format-to-format>
  a owl:Axiom ;
  sssom:record_id <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/distribution/format-to-format> ;
  dcterms:created "2026-10-19"^^xsd:date ;
  owl:annotatedProperty owl:equivalentClass ;
  owl:annotatedSource dcterms:format ; # ???
  owl:annotatedTarget dcterms:format ;
  sssom:confidence 0.9;
  sssom:mapping_justification semapv:ManualMappingCuration;
  sssom:subject_label "Format"@en;
  sssom:object_label "Format" ;
  sssom:see_also <https://github.com/Making-Sense-Info/Dedicate/blob/main/model-mapping.md#dctformat> ;
  sssom:see_also <https://docs.ddialliance.org/DDI-Lifecycle/3.3/xmlschema/schemas/dc_xsd/elements/any.html> ;
  sssom:comment "The `PhysicalInstance/Citation/format` maps to `dcterms:format" .
