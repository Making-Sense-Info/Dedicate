    owl:annotatedProperty owl:equivalentClass;
    owl:annotatedSource lifecycle:userId; # ❓ Which typeOfUserID when several? (e.g. ConstancesID)
    owl:annotatedTarget dcterms:identifier;
    sssom:confidence 0.8; # ⏳
    sssom:mapping_justification semapv:ManualMappingCuration;
    sssom:subject_label "UserID"@en;
    sssom:object_label "identifier"; # ❓ Optional? Overlaps with csvw:name?
    sssom:see_also <https://github.com/Making-Sense-Info/Dedicate/blob/main/model-mapping.md#dataset-structure--variables-healthdcat-ap--csvw> ; # ❓ Anchor stable?
    sssom:comment "The `Variable/UserID` maps to `dcterms:identifier` on the CSVW Column" .


<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/variables/studyunit-to-hasvariables>    a owl:Axiom;
    sssom:record_id <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/variables/studyunit-to-hasvariables> ; # ⏳
    pav:authoredBy "<http://id.making-sense.info/romain>";
    dcterms:created "2026-10-29"^^xsd:date;
    owl:annotatedProperty owl:equivalentClass; # ❓ Not a class equivalence — property attachment rule
    owl:annotatedSource lifecycle:studyUnit; # ❓ Source is StudyUnit but property is on dcat:Dataset
    owl:annotatedTarget healthdcatap:hasVariables; # ⏳ Confirm HealthDCAT-AP namespace IRI (http://healthdataportal.eu/ns/health#)
    sssom:confidence 0.8; # ⏳
    sssom:mapping_justification semapv:ManualMappingCuration;
    sssom:subject_label "StudyUnit"@en;
    sssom:object_label "has variables"; # ❓ Label wording
    sssom:see_also <https://github.com/Making-Sense-Info/Dedicate/blob/main/model-mapping.md#dataset-structure--variables-healthdcat-ap--csvw> ; # ❓ Anchor stable?
    sssom:see_also <https://healthdataeu.pages.code.europa.eu/healthdcat-ap/releases/release-7/changelog.html> ; # ⏳ Pin release (R7+ moved variables to Dataset)
    sssom:comment "The Dataset derived from `StudyUnit` links to the CSVW `TableGroup` with `healthdcatap:hasVariables`" .


<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/variables/variable-to-hasstructureddata>    a owl:Axiom;
    sssom:record_id <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/variables/variable-to-hasstructureddata> ; # ⏳
    pav:authoredBy "<http://id.making-sense.info/romain>";
    dcterms:created "2026-10-29"^^xsd:date;
    owl:annotatedProperty owl:equivalentClass; # ❓ Not a class equivalence — boolean presence rule
    owl:annotatedSource lifecycle:variable; # ❓ Awkward subject: presence of Variable ⇒ boolean on Dataset
    owl:annotatedTarget healthdcatap:hasStructuredData;
    sssom:confidence 0.7; # ⏳
    sssom:mapping_justification semapv:ManualMappingCuration;
    sssom:subject_label "Variable"@en;
    sssom:object_label "has structured data"; # ❓ Label wording
    sssom:see_also <https://github.com/Making-Sense-Info/Dedicate/blob/main/model-mapping.md#dataset-structure--variables-healthdcat-ap--csvw> ; # ❓ Anchor stable?
    sssom:comment "When `Variable` elements are present for the Dataset, `healthdcatap:hasStructuredData` is set to true" . # ❓ Omit vs false when no variables?
