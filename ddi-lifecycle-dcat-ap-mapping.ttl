# Dataset

<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/title-to-title>
    a owl:Axiom ;
    sssom:record_id <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/title-to-title> ; # ⏳
    pav:authoredBy "<http://id.making-sense.info/romain>"; # ❓ Level-up? Use MS?
    dcterms:created "2026-10-14"^^xsd:date;
    owl:annotatedProperty owl:equivalentClass; # https://www.w3.org/TR/owl-ref/#equivalentClass-def
    owl:annotatedSource lifecycle:title;
    owl:annotatedTarget dcterms:title;
    sssom:confidence 0.9; # ⏳
    sssom:mapping_justification semapv:ManualMappingCuration;
    sssom:subject_label "Title"@en; # https://docs.ddialliance.org/DDI-Lifecycle/dev/output/lifecycle40.ttl
    sssom:object_label "Title";
    sssom:see_also <https://github.com/Making-Sense-Info/Dedicate/blob/main/model-mapping.md#dcattitle> ; # ❓ Anchor stable?
    sssom:comment "We are mapping the `StudyUnit/Citation/Title` of DDI Lifecycle to the DC Terms `title` used in DCAT-AP" .

