<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/citation-dcterms-passthrough> a owl:Axiom;
    sssom:record_id <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/citation-dcterms-passthrough> ;
    dcterms:created "2026-11-04"^^xsd:date;
    owl:annotatedProperty owl:equivalentClass;
    owl:annotatedSource lifecycle:citation;
    owl:annotatedTarget dcterms:source; # ❓ Representative; also conformsTo, accessRights, accrualPeriodicity, modified
