# Variables
# ⏳ This mapping set targets HealthDCAT-AP + CSVW (not core DCAT-AP). Review with health profile.

<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/variables/dataset-to-tablegroup>
    a owl:Axiom ;
    sssom:record_id <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/variables/dataset-to-tablegroup> ;
    pav:authoredBy "<http://id.making-sense.info/romain>";
    dcterms:created "2026-11-05"^^xsd:date;
    owl:annotatedProperty owl:equivalentClass;
    owl:annotatedSource lifecycle:studyUnit;
    owl:annotatedTarget csvw:TableGroup;
    sssom:confidence 0.95;
    sssom:mapping_justification semapv:ManualMappingCuration;
    sssom:subject_label "StudyUnit / Dataset"@en;
    sssom:object_label "TableGroup";
    sssom:see_also <https://github.com/Making-Sense-Info/Dedicate/blob/main/model-mapping.md#dataset-structure--variables-healthdcat-ap--csvw> ;
    sssom:see_also <https://data.health.europa.eu/healthdcat-ap/releases/release-8/> ;
    sssom:comment "One `csvw:TableGroup` per Dataset (StudyUnit). Aggregates LogicalRecords from all PhysicalInstances of the StudyUnit, even when Mekong emits one LogicalProduct per PI. HealthDCAT-AP R8 TableGroup holds one or more tables." .

# Superseded by dataset-to-tablegroup (kept for history / redirects)
