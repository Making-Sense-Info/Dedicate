<https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/codelist-to-hascodingsystem> a owl:Axiom;
    sssom:record_id <https://making-sense.info/dedicate/ddi-lifecycle-to-dcat-ap/dataset/codelist-to-hascodingsystem> ;
    dcterms:created "2026-11-06"^^xsd:date;
    owl:annotatedProperty owl:equivalentClass;
    owl:annotatedSource lifecycle:codeList;
    owl:annotatedTarget healthdcatap:hasCodingSystem;
    sssom:confidence 0.75; # ⏳
    sssom:mapping_justification semapv:ManualMappingCuration;
    sssom:subject_label "CodeList"@en;
    sssom:object_label "coding system";
    sssom:see_also <https://data.health.europa.eu/healthdcat-ap/releases/release-8/#Dataset> ;
    sssom:comment "CodeLists referenced by Variables of the StudyUnit’s LogicalRecords -> `healthdcatap:hasCodingSystem` -> `dct:Standard` (IRI = CodeList URN - `dct:identifier` = UserID - `dct:title` from Label/Name). Prefer Coding System NAL / Wikidata IRIs when the list is a known medical coding system" .

