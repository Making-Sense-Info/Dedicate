<?xml version="1.0" encoding="UTF-8"?>
<!--
  DDI Lifecycle 3.3 → DCAT-AP (+ HealthDCAT-AP / CSVW variables) as Turtle.

  XSLT 3.0. Spec of record (not executed at runtime):
    ../../ddi-lifecycle-dcat-ap-mapping.ttl
    ../../model-mapping.md

  Run with Saxon-HE 12+ (see ../run.sh). Missing DDI fields are omitted.
-->
<xsl:stylesheet version="3.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:map="http://www.w3.org/2005/xpath-functions/map"
  xmlns:ded="https://making-sense.info/dedicate/xsl"
  xmlns:r="ddi:reusable:3_3"
  xmlns:s="ddi:studyunit:3_3"
  xmlns:pi="ddi:physicalinstance:3_3"
  xmlns:l="ddi:logicalproduct:3_3"
  exclude-result-prefixes="#all"
  expand-text="yes">

  <xsl:output method="text" encoding="UTF-8"/>
  <xsl:mode on-no-match="shallow-skip"/>

  <xsl:param name="base-uri" as="xs:string" select="''"/>

  <!-- Fast URN → element lookup -->
  <xsl:key name="by-urn"
    match="pi:PhysicalInstance | l:Variable | l:DataRelationship | l:LogicalProduct | l:LogicalRecord"
    use="normalize-space(r:URN)"/>

  <!-- DDI RecommendedDataType → XSD datatype QName-as-Turtle -->
  <xsl:variable name="ded:datatype-map" as="map(xs:string, xs:string)" select="map{
      'String'          : 'xsd:string',
      'Numeric'         : 'xsd:decimal',
      'Float'           : 'xsd:decimal',
      'Double'          : 'xsd:decimal',
      'Decimal'         : 'xsd:decimal',
      'Integer'         : 'xsd:integer',
      'UnsignedInt'     : 'xsd:integer',
      'Long'            : 'xsd:integer',
      'Date'            : 'xsd:date',
      'DateTime'        : 'xsd:dateTime',
      'Boolean'         : 'xsd:boolean',
      'BooleanNumeric'  : 'xsd:boolean'
    }"/>

  <!-- ===================================================================== -->
  <!-- Entry                                                                 -->
  <!-- ===================================================================== -->

  <xsl:template match="/">
    <xsl:text>@prefix csvw: &lt;http://www.w3.org/ns/csvw#&gt; .&#10;</xsl:text>
    <xsl:text>@prefix dcat: &lt;http://www.w3.org/ns/dcat#&gt; .&#10;</xsl:text>
    <xsl:text>@prefix dcterms: &lt;http://purl.org/dc/terms/&gt; .&#10;</xsl:text>
    <xsl:text>@prefix foaf: &lt;http://xmlns.com/foaf/0.1/&gt; .&#10;</xsl:text>
    <xsl:text>@prefix healthdcatap: &lt;http://healthdataportal.eu/ns/health#&gt; .&#10;</xsl:text>
    <xsl:text>@prefix vcard: &lt;http://www.w3.org/2006/vcard/ns#&gt; .&#10;</xsl:text>
    <xsl:text>@prefix xsd: &lt;http://www.w3.org/2001/XMLSchema#&gt; .&#10;&#10;</xsl:text>
    <xsl:text># Generated by Dedicate ddi-l-to-healthdcat-ap/xsl/ddi-lifecycle-to-dcat-ap.xsl (XSLT 3.0)&#10;</xsl:text>
    <xsl:text># Mapping driver: ddi-lifecycle-dcat-ap-mapping.ttl (curated SSSOM; not executed as-is)&#10;&#10;</xsl:text>

    <xsl:apply-templates select="//r:Organization[
        exists(r:OrganizationIdentification/r:OrganizationName/r:String)
        or exists(r:OrganizationName/r:String)
      ]" mode="catalog"/>

    <xsl:apply-templates select="//s:StudyUnit" mode="dataset"/>
  </xsl:template>

  <!-- ===================================================================== -->
  <!-- Catalog                                                               -->
  <!-- ===================================================================== -->

  <xsl:template match="r:Organization" mode="catalog">
    <xsl:variable name="org-uri" as="xs:string"
      select="ded:resource-uri(r:URN, 'urn:dedicate:org:', .)"/>
    <xsl:variable name="org-name" as="element(r:String)?"
      select="(r:OrganizationIdentification/r:OrganizationName/r:String | r:OrganizationName/r:String)[1]"/>
    <xsl:variable name="catalog-uri" as="xs:string"
      select="'urn:dedicate:catalog:' || (
        if (normalize-space(r:URN)) then normalize-space(r:URN) else generate-id()
      )"/>
    <xsl:variable name="name-lit" as="xs:string"
      select="ded:literal(normalize-space($org-name), $org-name/@xml:lang)"/>

    <xsl:text>{ded:iri($catalog-uri)}&#10;</xsl:text>
    <xsl:text>  a dcat:Catalog ;&#10;</xsl:text>
    <xsl:text>  dcterms:title "Catalog for {ded:turtle-escape(normalize-space($org-name))}"{
      if ($org-name/@xml:lang) then '@' || $org-name/@xml:lang else ''
    } ;&#10;</xsl:text>
    <xsl:text>  dcterms:description "Catalog for {ded:turtle-escape(normalize-space($org-name))}"{
      if ($org-name/@xml:lang) then '@' || $org-name/@xml:lang else ''
    } ;&#10;</xsl:text>
    <xsl:text>  dcterms:publisher {ded:iri($org-uri)} .&#10;&#10;</xsl:text>

    <xsl:text>{ded:iri($org-uri)}&#10;</xsl:text>
    <xsl:text>  a foaf:Agent ;&#10;</xsl:text>
    <xsl:text>  foaf:name {$name-lit} .&#10;&#10;</xsl:text>
  </xsl:template>

  <!-- ===================================================================== -->
  <!-- Dataset + linked Distributions + variables structure                  -->
  <!-- ===================================================================== -->

  <xsl:template match="s:StudyUnit" mode="dataset">
    <xsl:variable name="root" as="document-node()" select="root()"/>
    <xsl:variable name="dataset-uri" as="xs:string"
      select="ded:resource-uri(r:URN, 'urn:dedicate:dataset:', .)"/>

    <xsl:variable name="pis" as="element(pi:PhysicalInstance)*"
      select="r:PhysicalInstanceReference/r:URN
                ! normalize-space(.)
                ! key('by-urn', ., $root)[self::pi:PhysicalInstance]"/>

    <xsl:variable name="dr-urns" as="xs:string*"
      select="distinct-values(
        $pis/(r:DataRelationshipReference | *[local-name() eq 'DataRelationshipReference'])
          /r:URN ! normalize-space(.)[. ne '']
      )"/>

    <xsl:variable name="logical-products" as="element(l:LogicalProduct)*">
      <xsl:for-each-group
        select="$dr-urns ! key('by-urn', ., $root)[self::l:DataRelationship]/parent::l:LogicalProduct"
        group-by="generate-id()">
        <xsl:sequence select="."/>
      </xsl:for-each-group>
    </xsl:variable>

    <xsl:variable name="logical-records" as="element(l:LogicalRecord)*"
      select="$logical-products/l:DataRelationship[normalize-space(r:URN) = $dr-urns]/l:LogicalRecord"/>

    <xsl:variable name="has-variables" as="xs:boolean"
      select="exists($logical-records/l:VariablesInRecord/l:VariableUsedReference)"/>

    <!-- Dataset resource -->
    <xsl:text>{ded:iri($dataset-uri)}&#10;</xsl:text>
    <xsl:text>  a dcat:Dataset</xsl:text>

    <xsl:for-each select="r:Citation/r:Title/r:String">
      <xsl:text> ;&#10;  dcterms:title {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>

    <xsl:for-each select="r:Citation/r:Description/(r:Content | r:String)">
      <xsl:text> ;&#10;  dcterms:description {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>

    <xsl:apply-templates select="r:Coverage/r:TopicalCoverage/r:Keyword" mode="keyword-or-theme"/>

    <xsl:apply-templates select=".//r:ContactInformation[1]" mode="contact-point"/>

    <xsl:for-each select="$pis">
      <xsl:text> ;&#10;  dcat:distribution {
        ded:iri(ded:resource-uri(r:URN, 'urn:dedicate:distribution:', .))
      }</xsl:text>
    </xsl:for-each>

    <xsl:if test="$has-variables">
      <xsl:text> ;&#10;  healthdcatap:hasStructuredData true</xsl:text>
    </xsl:if>

    <xsl:for-each select="$logical-products">
      <xsl:text> ;&#10;  healthdcatap:hasVariables {
        ded:iri(ded:resource-uri(r:URN, 'urn:dedicate:tablegroup:', .))
      }</xsl:text>
    </xsl:for-each>

    <xsl:text> .&#10;&#10;</xsl:text>

    <xsl:apply-templates select="$pis" mode="distribution"/>

    <xsl:apply-templates select="$logical-products" mode="tablegroup">
      <xsl:with-param name="dr-urns" select="$dr-urns"/>
      <xsl:with-param name="root" select="$root"/>
    </xsl:apply-templates>
  </xsl:template>

  <!-- Keywords / themes -->
  <xsl:template match="r:Keyword" mode="keyword-or-theme">
    <xsl:choose>
      <xsl:when test="@codeListID or normalize-space(r:Code) or starts-with(normalize-space(r:String), 'http')">
        <xsl:variable name="theme-uri" as="xs:string" select="
            if (starts-with(normalize-space(r:String), 'http')) then normalize-space(r:String)
            else if (normalize-space(r:Code)) then normalize-space(r:Code)
            else 'http://publications.europa.eu/resource/authority/data-theme/HEAL'
          "/>
        <xsl:text> ;&#10;  dcat:theme {ded:iri($theme-uri)}</xsl:text>
      </xsl:when>
      <xsl:when test="normalize-space(r:String) or normalize-space(.)">
        <xsl:variable name="node" as="node()" select="(r:String | .)[1]"/>
        <xsl:text> ;&#10;  dcat:keyword {
          ded:literal(normalize-space($node), $node/@xml:lang)
        }</xsl:text>
      </xsl:when>
    </xsl:choose>
  </xsl:template>

  <xsl:template match="r:ContactInformation" mode="contact-point">
    <xsl:variable name="fn" as="xs:string?"
      select="normalize-space((
          r:IndividualName/r:FullName/r:String
        | r:IndividualName/r:String
        | r:OrganizationName/r:String
      )[1])[. ne '']"/>
    <xsl:variable name="email" as="xs:string?"
      select="normalize-space(r:Email)[. ne '']"/>
    <xsl:text> ;&#10;  dcat:contactPoint [&#10;    a vcard:Kind</xsl:text>
    <xsl:if test="$fn">
      <xsl:text> ;&#10;    vcard:fn {ded:literal($fn)}</xsl:text>
    </xsl:if>
    <xsl:if test="$email">
      <xsl:text> ;&#10;    vcard:hasEmail {ded:iri('mailto:' || $email)}</xsl:text>
    </xsl:if>
    <xsl:text>&#10;  ]</xsl:text>
  </xsl:template>

  <!-- ===================================================================== -->
  <!-- Distribution                                                          -->
  <!-- ===================================================================== -->

  <xsl:template match="pi:PhysicalInstance" mode="distribution">
    <xsl:variable name="dist-uri" as="xs:string"
      select="ded:resource-uri(r:URN, 'urn:dedicate:distribution:', .)"/>

    <xsl:text>{ded:iri($dist-uri)}&#10;</xsl:text>
    <xsl:text>  a dcat:Distribution</xsl:text>

    <xsl:for-each select="r:Citation/r:Title/r:String">
      <xsl:text> ;&#10;  dcterms:title {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>

    <xsl:for-each select="(
        r:DataFileIdentification
      | pi:DataFileIdentification
      | *[local-name() eq 'DataFileIdentification']
      )/*[local-name() eq 'DataFileURI'] ! normalize-space(.)[. ne '']">
      <xsl:variable name="uri" as="xs:string" select="
          if (matches(., '^(https?|urn|file):', 'i')) then .
          else if ($base-uri) then $base-uri || .
          else .
        "/>
      <xsl:text> ;&#10;  dcat:accessURL {ded:iri($uri)}</xsl:text>
    </xsl:for-each>

    <xsl:for-each select="r:Citation/r:Description/(r:Content | r:String)">
      <xsl:text> ;&#10;  dcterms:description {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>

    <xsl:for-each select="(
        r:Citation/(r:Format | *[local-name() = ('format', 'Format')])
      | r:Citation/r:DCTerms/*[local-name() eq 'format']
      ) ! normalize-space(.)[. ne '']">
      <xsl:text> ;&#10;  dcterms:format {ded:literal(.)}</xsl:text>
    </xsl:for-each>

    <xsl:text> .&#10;&#10;</xsl:text>
  </xsl:template>

  <!-- ===================================================================== -->
  <!-- Variables: TableGroup / Table / Column                                -->
  <!-- ===================================================================== -->

  <xsl:template match="l:LogicalProduct" mode="tablegroup">
    <xsl:param name="dr-urns" as="xs:string*"/>
    <xsl:param name="root" as="document-node()"/>

    <xsl:variable name="tg-uri" as="xs:string"
      select="ded:resource-uri(r:URN, 'urn:dedicate:tablegroup:', .)"/>
    <xsl:variable name="records" as="element(l:LogicalRecord)*"
      select="l:DataRelationship[normalize-space(r:URN) = $dr-urns]/l:LogicalRecord"/>

    <xsl:text>{ded:iri($tg-uri)}&#10;</xsl:text>
    <xsl:text>  a csvw:TableGroup</xsl:text>
    <xsl:for-each select="$records">
      <xsl:text> ;&#10;  csvw:table {
        ded:iri(ded:resource-uri(r:URN, 'urn:dedicate:table:', .))
      }</xsl:text>
    </xsl:for-each>
    <xsl:text> .&#10;&#10;</xsl:text>

    <xsl:apply-templates select="$records" mode="table">
      <xsl:with-param name="root" select="$root"/>
    </xsl:apply-templates>
  </xsl:template>

  <xsl:template match="l:LogicalRecord" mode="table">
    <xsl:param name="root" as="document-node()"/>
    <xsl:variable name="table-uri" as="xs:string"
      select="ded:resource-uri(r:URN, 'urn:dedicate:table:', .)"/>
    <xsl:variable name="variables" as="element(l:Variable)*"
      select="l:VariablesInRecord/l:VariableUsedReference/r:URN
                ! normalize-space(.)
                ! key('by-urn', ., $root)[self::l:Variable]"/>

    <xsl:text>{ded:iri($table-uri)}&#10;</xsl:text>
    <xsl:text>  a csvw:Table</xsl:text>

    <xsl:for-each select="l:LogicalRecordName/r:String">
      <xsl:text> ;&#10;  dcterms:title {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>

    <xsl:for-each select="$variables">
      <xsl:text> ;&#10;  csvw:column {
        ded:iri(ded:resource-uri(r:URN, 'urn:dedicate:column:', .))
      }</xsl:text>
    </xsl:for-each>

    <xsl:text> .&#10;&#10;</xsl:text>

    <xsl:apply-templates select="$variables" mode="column"/>
  </xsl:template>

  <xsl:template match="l:Variable" mode="column">
    <xsl:variable name="col-uri" as="xs:string"
      select="ded:resource-uri(r:URN, 'urn:dedicate:column:', .)"/>
    <xsl:variable name="name" as="xs:string?"
      select="normalize-space((l:VariableName/r:String)[1])[. ne '']"/>
    <xsl:variable name="datatype" as="xs:string?"
      select="ded:map-datatype(.)"/>

    <xsl:text>{ded:iri($col-uri)}&#10;</xsl:text>
    <xsl:text>  a csvw:Column</xsl:text>

    <xsl:if test="$name">
      <xsl:text> ;&#10;  csvw:name {ded:literal($name)}</xsl:text>
    </xsl:if>

    <xsl:for-each select="r:Label/r:Content">
      <xsl:text> ;&#10;  csvw:title {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>

    <xsl:for-each select="r:Description/r:Content">
      <xsl:text> ;&#10;  dcterms:description {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>

    <xsl:for-each select="r:UserID ! normalize-space(.)[. ne '']">
      <xsl:text> ;&#10;  dcterms:identifier {ded:literal(.)}</xsl:text>
    </xsl:for-each>

    <xsl:if test="$datatype">
      <xsl:text> ;&#10;  csvw:datatype {$datatype}</xsl:text>
    </xsl:if>

    <xsl:for-each select="r:ConceptReference[normalize-space(r:URN)][1]/r:URN ! normalize-space(.)">
      <xsl:text> ;&#10;  csvw:propertyUrl {ded:iri(.)}</xsl:text>
    </xsl:for-each>

    <xsl:text> .&#10;&#10;</xsl:text>
  </xsl:template>

  <!-- ===================================================================== -->
  <!-- Functions                                                             -->
  <!-- ===================================================================== -->

  <xsl:function name="ded:resource-uri" as="xs:string">
    <xsl:param name="urn" as="item()?"/>
    <xsl:param name="fallback-prefix" as="xs:string"/>
    <xsl:param name="node" as="node()"/>
    <xsl:sequence select="
        let $u := normalize-space(string(($urn, '')[1]))
        return if ($u) then $u else $fallback-prefix || generate-id($node)
      "/>
  </xsl:function>

  <xsl:function name="ded:iri" as="xs:string">
    <xsl:param name="uri" as="xs:string"/>
    <xsl:sequence select="'&lt;' || $uri || '&gt;'"/>
  </xsl:function>

  <xsl:function name="ded:turtle-escape" as="xs:string">
    <xsl:param name="text" as="xs:string?"/>
    <xsl:sequence select="
        replace(
          replace(
            replace(string(($text, '')[1]), '\\', '\\\\'),
            '&quot;', '\\&quot;'
          ),
          '&#10;', '\\n'
        )
      "/>
  </xsl:function>

  <xsl:function name="ded:literal" as="xs:string">
    <xsl:param name="text" as="xs:string?"/>
    <xsl:param name="lang" as="xs:string?"/>
    <xsl:sequence select="
        '&quot;' || ded:turtle-escape($text) || '&quot;'
        || (if (exists($lang) and normalize-space($lang))
            then '@' || normalize-space($lang)
            else '')
      "/>
  </xsl:function>

  <!-- One-arg overload for convenience -->
  <xsl:function name="ded:literal" as="xs:string">
    <xsl:param name="text" as="xs:string?"/>
    <xsl:sequence select="ded:literal($text, ())"/>
  </xsl:function>

  <xsl:function name="ded:map-datatype" as="xs:string?">
    <xsl:param name="variable" as="element(l:Variable)"/>
    <xsl:variable name="rdt" as="xs:string?"
      select="normalize-space(($variable/l:VariableRepresentation//r:RecommendedDataType)[1])[. ne '']"/>
    <xsl:sequence select="
        if (exists($rdt) and map:contains($ded:datatype-map, $rdt))
        then $ded:datatype-map($rdt)
        else if ($variable/l:VariableRepresentation/r:TextRepresentation) then 'xsd:string'
        else if ($variable/l:VariableRepresentation/r:NumericRepresentation) then 'xsd:decimal'
        else if ($variable/l:VariableRepresentation/r:DateTimeRepresentation) then 'xsd:dateTime'
        else if ($variable/l:VariableRepresentation/r:CodeRepresentation) then 'xsd:string'
        else ()
      "/>
  </xsl:function>

</xsl:stylesheet>
