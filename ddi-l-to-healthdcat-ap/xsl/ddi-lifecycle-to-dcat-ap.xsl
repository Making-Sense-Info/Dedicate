<?xml version="1.0" encoding="UTF-8"?>
<!--
  DDI Lifecycle 3.3 → DCAT-AP (+ HealthDCAT-AP / CSVW variables) as Turtle.

  XSLT 3.0. Spec of record (not executed at runtime):
    ../../ddi-lifecycle-dcat-ap-mapping.ttl
    ../../model-mapping.md

  Run with Saxon-HE 12+ (see ../run.sh). Missing DDI fields are omitted.
-->
<xsl:stylesheet version="3.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:map="http://www.w3.org/2005/xpath-functions/map"
  xmlns:ded="https://making-sense.info/dedicate/xsl"
  xmlns:r="ddi:reusable:3_3"
  xmlns:s="ddi:studyunit:3_3"
  xmlns:pi="ddi:physicalinstance:3_3"
  xmlns:l="ddi:logicalproduct:3_3"
  xmlns:dcterms="http://purl.org/dc/terms/"
  exclude-result-prefixes="#all"
  expand-text="yes">

  <xsl:output method="text" encoding="UTF-8"/>
  <xsl:mode on-no-match="shallow-skip"/>

  <xsl:param name="base-uri" as="xs:string" select="''"/>

  <!-- dcterms children Mekong may put under StudyUnit/Citation -->
  <xsl:variable name="ded:citation-dcterms" as="xs:string*" select="(
      'description', 'source', 'conformsTo', 'accessRights', 'accrualPeriodicity', 'modified'
    )"/>

  <!-- Fast URN → element lookup -->
  <xsl:key name="by-urn"
    match="pi:PhysicalInstance | l:Variable | l:DataRelationship | l:LogicalProduct | l:LogicalRecord
         | l:CodeList | l:Code | l:CategoryScheme | l:Category"
    use="normalize-space(r:URN)"/>

  <!-- DDI RecommendedDataType → CSVW built-in datatype name (HealthDCAT-AP R8 SHACL: literal, not XSD IRI)
       Ref: Dedicate #7, upstream #61. Names from W3C CSVW §6.6. -->
  <xsl:variable name="ded:datatype-map" as="map(xs:string, xs:string)" select="map{
      'String'          : 'string',
      'Numeric'         : 'decimal',
      'Float'           : 'float',
      'Double'          : 'double',
      'Decimal'         : 'decimal',
      'Integer'         : 'integer',
      'UnsignedInt'     : 'unsignedInt',
      'Long'            : 'long',
      'Date'            : 'date',
      'DateTime'        : 'dateTime',
      'Boolean'         : 'boolean',
      'BooleanNumeric'  : 'boolean'
    }"/>

  <!-- ===================================================================== -->
  <!-- Entry                                                                 -->
  <!-- ===================================================================== -->

  <xsl:template match="/">
    <xsl:text>@prefix csvw: &lt;http://www.w3.org/ns/csvw#&gt; .&#10;</xsl:text>
    <xsl:text>@prefix dcat: &lt;http://www.w3.org/ns/dcat#&gt; .&#10;</xsl:text>
    <xsl:text>@prefix dcterms: &lt;http://purl.org/dc/terms/&gt; .&#10;</xsl:text>
    <xsl:text>@prefix foaf: &lt;http://xmlns.com/foaf/0.1/&gt; .&#10;</xsl:text>
    <xsl:text>@prefix healthdcatap: &lt;http://healthdataportal.eu/ns/health#&gt; .&#10;</xsl:text>
    <xsl:text>@prefix rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt; .&#10;</xsl:text>
    <xsl:text>@prefix skos: &lt;http://www.w3.org/2004/02/skos/core#&gt; .&#10;</xsl:text>
    <xsl:text>@prefix vcard: &lt;http://www.w3.org/2006/vcard/ns#&gt; .&#10;</xsl:text>
    <xsl:text>@prefix xsd: &lt;http://www.w3.org/2001/XMLSchema#&gt; .&#10;&#10;</xsl:text>
    <xsl:text># Generated by Dedicate ddi-l-to-healthdcat-ap/xsl/ddi-lifecycle-to-dcat-ap.xsl (XSLT 3.0)&#10;</xsl:text>
    <xsl:text># Mapping driver: ddi-lifecycle-dcat-ap-mapping.ttl (curated SSSOM; not executed as-is)&#10;&#10;</xsl:text>

    <xsl:apply-templates select="//r:Organization[
        exists(r:OrganizationIdentification/r:OrganizationName/r:String)
        or exists(r:OrganizationName/r:String)
      ]" mode="catalog"/>

    <xsl:apply-templates select="//s:StudyUnit" mode="dataset"/>
  </xsl:template>

  <!-- ===================================================================== -->
  <!-- Catalog                                                               -->
  <!-- ===================================================================== -->

  <xsl:template match="r:Organization" mode="catalog">
    <xsl:variable name="org-uri" as="xs:string"
      select="ded:resource-uri(r:URN, 'urn:dedicate:org:', .)"/>
    <xsl:variable name="org-name" as="element(r:String)?"
      select="(r:OrganizationIdentification/r:OrganizationName/r:String | r:OrganizationName/r:String)[1]"/>
    <xsl:variable name="catalog-uri" as="xs:string"
      select="'urn:dedicate:catalog:' || (
        if (normalize-space(r:URN)) then normalize-space(r:URN) else generate-id()
      )"/>
    <xsl:variable name="name-lit" as="xs:string"
      select="ded:literal(normalize-space($org-name), $org-name/@xml:lang)"/>

    <xsl:text>{ded:iri($catalog-uri)}&#10;</xsl:text>
    <xsl:text>  a dcat:Catalog ;&#10;</xsl:text>
    <xsl:text>  dcterms:title "Catalog for {ded:turtle-escape(normalize-space($org-name))}"{
      if ($org-name/@xml:lang) then '@' || $org-name/@xml:lang else ''
    } ;&#10;</xsl:text>
    <xsl:text>  dcterms:description "Catalog for {ded:turtle-escape(normalize-space($org-name))}"{
      if ($org-name/@xml:lang) then '@' || $org-name/@xml:lang else ''
    } ;&#10;</xsl:text>
    <xsl:text>  dcterms:publisher {ded:iri($org-uri)} .&#10;&#10;</xsl:text>

    <xsl:text>{ded:iri($org-uri)}&#10;</xsl:text>
    <xsl:text>  a foaf:Agent ;&#10;</xsl:text>
    <xsl:text>  foaf:name {$name-lit} .&#10;&#10;</xsl:text>
  </xsl:template>

  <!-- ===================================================================== -->
  <!-- Dataset + linked Distributions + variables structure                  -->
  <!-- ===================================================================== -->

  <xsl:template match="s:StudyUnit" mode="dataset">
    <xsl:variable name="root" as="document-node()" select="root()"/>
    <xsl:variable name="dataset-uri" as="xs:string"
      select="ded:resource-uri(r:URN, 'urn:dedicate:dataset:', .)"/>

    <xsl:variable name="pis" as="element(pi:PhysicalInstance)*"
      select="r:PhysicalInstanceReference/r:URN
                ! normalize-space(.)
                ! key('by-urn', ., $root)[self::pi:PhysicalInstance]"/>

    <xsl:variable name="dr-urns" as="xs:string*"
      select="distinct-values(
        $pis/(r:DataRelationshipReference | *[local-name() eq 'DataRelationshipReference'])
          /r:URN ! normalize-space(.)[. ne '']
      )"/>

    <!-- All LogicalRecords behind this StudyUnit's PIs (across LogicalProducts) -->
    <xsl:variable name="logical-records" as="element(l:LogicalRecord)*">
      <xsl:for-each-group
        select="$dr-urns ! key('by-urn', ., $root)[self::l:DataRelationship]/l:LogicalRecord"
        group-by="generate-id()">
        <xsl:sequence select="."/>
      </xsl:for-each-group>
    </xsl:variable>

    <xsl:variable name="has-variables" as="xs:boolean"
      select="exists($logical-records/l:VariablesInRecord/l:VariableUsedReference)"/>

    <!-- Variables of this Dataset (for CodeList scoping) -->
    <xsl:variable name="dataset-variables" as="element(l:Variable)*">
      <xsl:for-each-group
        select="$logical-records/l:VariablesInRecord/l:VariableUsedReference/r:URN
                  ! normalize-space(.)
                  ! key('by-urn', ., $root)[self::l:Variable]"
        group-by="generate-id()">
        <xsl:sequence select="."/>
      </xsl:for-each-group>
    </xsl:variable>

    <!-- CodeLists referenced by those variables' CodeRepresentation -->
    <xsl:variable name="code-lists" as="element(l:CodeList)*">
      <xsl:for-each-group
        select="$dataset-variables
                  /l:VariableRepresentation/r:CodeRepresentation/r:CodeListReference/r:URN
                  ! normalize-space(.)[. ne '']
                  ! key('by-urn', ., $root)[self::l:CodeList]"
        group-by="generate-id()">
        <xsl:sequence select="."/>
      </xsl:for-each-group>
    </xsl:variable>

    <!-- One TableGroup per Dataset (HealthDCAT-AP idiom), not per LogicalProduct -->
    <xsl:variable name="tablegroup-uri" as="xs:string"
      select="ded:resource-uri(r:URN, 'urn:dedicate:tablegroup:', .) || '/variables'"/>

    <!-- Dataset resource (StudyUnit Citation / Coverage → DCAT Dataset) -->
    <xsl:text>{ded:iri($dataset-uri)}&#10;</xsl:text>
    <xsl:text>  a dcat:Dataset</xsl:text>

    <xsl:for-each select="r:Citation/r:Title/r:String">
      <xsl:text> ;&#10;  dcterms:title {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>

    <!-- description: classic Citation/Description and/or dcterms:description children -->
    <xsl:for-each select="
        r:Citation/r:Description/(r:Content | r:String)
      | r:Citation/dcterms:description
      | r:Citation/*[namespace-uri() eq 'http://purl.org/dc/terms/' and local-name() eq 'description']
      ">
      <xsl:text> ;&#10;  dcterms:description {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>

    <xsl:apply-templates select="r:Citation/r:Creator" mode="dataset-creator"/>
    <xsl:apply-templates select="r:Citation/r:Publisher" mode="dataset-publisher"/>

    <xsl:for-each select="r:Citation/r:Language ! normalize-space(.)[. ne '']">
      <xsl:choose>
        <xsl:when test="matches(., '^(https?|urn):', 'i')">
          <xsl:text> ;&#10;  dcterms:language {ded:iri(.)}</xsl:text>
        </xsl:when>
        <xsl:otherwise>
          <xsl:text> ;&#10;  dcterms:language {ded:literal(.)}</xsl:text>
        </xsl:otherwise>
      </xsl:choose>
    </xsl:for-each>

    <xsl:for-each select="r:Citation/r:InternationalIdentifier/r:IdentifierContent
                            ! normalize-space(.)[. ne '']">
      <xsl:text> ;&#10;  dcterms:identifier {ded:literal(.)}</xsl:text>
    </xsl:for-each>

    <!-- Other dcterms:* under Citation (source, conformsTo, accessRights, …).
         Whole-value URI, or catalogue "Label (http://…)" → IRI; else literal. -->
    <xsl:for-each-group
      select="r:Citation/*[
          namespace-uri() eq 'http://purl.org/dc/terms/'
          and local-name() = $ded:citation-dcterms
          and local-name() ne 'description'
        ]"
      group-by="local-name() || '|' || ded:dcterms-object-key(.)">
      <xsl:variable name="prop" as="xs:string" select="'dcterms:' || local-name()"/>
      <xsl:variable name="val" as="xs:string" select="normalize-space(.)"/>
      <xsl:variable name="embedded-uri" as="xs:string?"
        select="ded:embedded-uri($val)"/>
      <xsl:if test="$val">
        <xsl:choose>
          <xsl:when test="matches($val, '^(https?|urn):', 'i')">
            <xsl:text> ;&#10;  {$prop} {ded:iri($val)}</xsl:text>
          </xsl:when>
          <xsl:when test="$embedded-uri">
            <xsl:text> ;&#10;  {$prop} {ded:iri($embedded-uri)}</xsl:text>
          </xsl:when>
          <xsl:otherwise>
            <xsl:text> ;&#10;  {$prop} {ded:literal($val, @xml:lang)}</xsl:text>
          </xsl:otherwise>
        </xsl:choose>
      </xsl:if>
    </xsl:for-each-group>

    <!-- theme = Subject (+ optional controlledVocabularyURN); keyword = Keyword text -->
    <xsl:for-each-group
      select="r:Coverage/r:TopicalCoverage/r:Subject"
      group-by="normalize-space((@controlledVocabularyURN,
        (r:String | r:Code | text()[normalize-space()])[1])[normalize-space(.)][1])">
      <xsl:apply-templates select="." mode="dataset-theme"/>
    </xsl:for-each-group>
    <xsl:apply-templates select="r:Coverage/r:TopicalCoverage/r:Keyword" mode="dataset-keyword"/>

    <xsl:apply-templates select="r:Coverage/r:SpatialCoverage" mode="dataset-spatial"/>
    <xsl:apply-templates select="r:Coverage/r:TemporalCoverage" mode="dataset-temporal"/>

    <!-- contactPoint: ContactInformation if present, else Contributor names (Mekong DCAT binding) -->
    <xsl:choose>
      <xsl:when test="exists(.//r:ContactInformation)">
        <xsl:apply-templates select="(.//r:ContactInformation)[1]" mode="contact-point"/>
      </xsl:when>
      <xsl:otherwise>
        <xsl:apply-templates select="r:Citation/r:Contributor[1]" mode="contact-from-contributor"/>
      </xsl:otherwise>
    </xsl:choose>

    <xsl:for-each select="$pis">
      <xsl:text> ;&#10;  dcat:distribution {
        ded:iri(ded:resource-uri(r:URN, 'urn:dedicate:distribution:', .))
      }</xsl:text>
    </xsl:for-each>

    <xsl:if test="$has-variables">
      <xsl:text> ;&#10;  healthdcatap:hasStructuredData true</xsl:text>
      <xsl:text> ;&#10;  healthdcatap:hasVariables {ded:iri($tablegroup-uri)}</xsl:text>
    </xsl:if>

    <!-- Coding systems / code values (HealthDCAT-AP), scoped to this Dataset's variables -->
    <xsl:for-each select="$code-lists">
      <xsl:text> ;&#10;  healthdcatap:hasCodingSystem {
        ded:iri(ded:resource-uri(r:URN, 'urn:dedicate:codelist:', .))
      }</xsl:text>
    </xsl:for-each>
    <xsl:for-each select="$code-lists/l:Code">
      <xsl:text> ;&#10;  healthdcatap:hasCodeValues {
        ded:iri(ded:resource-uri(r:URN, 'urn:dedicate:code:', .))
      }</xsl:text>
    </xsl:for-each>

    <xsl:text> .&#10;&#10;</xsl:text>

    <xsl:apply-templates select="$pis" mode="distribution"/>

    <xsl:apply-templates select="$code-lists" mode="coding-system">
      <xsl:with-param name="root" select="$root"/>
    </xsl:apply-templates>

    <xsl:if test="$has-variables">
      <xsl:call-template name="ded:emit-tablegroup">
        <xsl:with-param name="tablegroup-uri" select="$tablegroup-uri"/>
        <xsl:with-param name="records" select="$logical-records"/>
        <xsl:with-param name="root" select="$root"/>
        <xsl:with-param name="title-strings" select="r:Citation/r:Title/r:String"/>
      </xsl:call-template>
    </xsl:if>
  </xsl:template>

  <!-- Creator / Publisher bibliographic names → foaf:Agent -->
  <xsl:template match="r:Creator" mode="dataset-creator">
    <xsl:variable name="names" as="element(r:String)*"
      select="r:CreatorName/r:String | r:OrganizationName/r:String"/>
    <xsl:if test="exists($names)">
      <xsl:text> ;&#10;  dcterms:creator [&#10;    a foaf:Agent</xsl:text>
      <xsl:for-each select="$names">
        <xsl:text> ;&#10;    foaf:name {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
      </xsl:for-each>
      <xsl:text>&#10;  ]</xsl:text>
    </xsl:if>
  </xsl:template>

  <xsl:template match="r:Publisher" mode="dataset-publisher">
    <xsl:variable name="names" as="element(r:String)*"
      select="r:PublisherName/r:String | r:OrganizationName/r:String"/>
    <xsl:if test="exists($names)">
      <xsl:text> ;&#10;  dcterms:publisher [&#10;    a foaf:Agent</xsl:text>
      <xsl:for-each select="$names">
        <xsl:text> ;&#10;    foaf:name {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
      </xsl:for-each>
      <xsl:text>&#10;  ]</xsl:text>
    </xsl:if>
  </xsl:template>

  <xsl:template match="r:Subject" mode="dataset-theme">
    <xsl:variable name="cv" as="xs:string?"
      select="normalize-space(@controlledVocabularyURN)[. ne '']"/>
    <xsl:variable name="text" as="xs:string?"
      select="normalize-space((r:String | r:Code | text()[normalize-space()])[1])[. ne '']"/>
    <xsl:choose>
      <xsl:when test="$cv">
        <xsl:text> ;&#10;  dcat:theme {ded:iri($cv)}</xsl:text>
      </xsl:when>
      <xsl:when test="$text and matches($text, '^(https?|urn):', 'i')">
        <xsl:text> ;&#10;  dcat:theme {ded:iri($text)}</xsl:text>
      </xsl:when>
    </xsl:choose>
  </xsl:template>

  <xsl:template match="r:Keyword" mode="dataset-keyword">
    <xsl:choose>
      <!-- legacy: Keyword carrying a CV URI was sometimes used as theme -->
      <xsl:when test="@controlledVocabularyURN or @codeListID
          or normalize-space(r:Code)
          or starts-with(normalize-space(r:String), 'http')
          or starts-with(normalize-space(string(.)), 'http')">
        <xsl:variable name="theme-uri" as="xs:string" select="
            if (normalize-space(@controlledVocabularyURN)) then normalize-space(@controlledVocabularyURN)
            else if (starts-with(normalize-space(r:String), 'http')) then normalize-space(r:String)
            else if (normalize-space(r:Code)) then normalize-space(r:Code)
            else if (starts-with(normalize-space(string(.)), 'http')) then normalize-space(string(.))
            else 'http://publications.europa.eu/resource/authority/data-theme/HEAL'
          "/>
        <xsl:text> ;&#10;  dcat:theme {ded:iri($theme-uri)}</xsl:text>
      </xsl:when>
      <xsl:when test="normalize-space(r:String)">
        <xsl:text> ;&#10;  dcat:keyword {
          ded:literal(normalize-space(r:String), (r:String/@xml:lang, @xml:lang)[1])
        }</xsl:text>
      </xsl:when>
      <xsl:when test="normalize-space(.)">
        <xsl:text> ;&#10;  dcat:keyword {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
      </xsl:when>
    </xsl:choose>
  </xsl:template>

  <xsl:template match="r:SpatialCoverage" mode="dataset-spatial">
    <xsl:variable name="labels" as="element(r:Content)*" select="r:Description/r:Content"/>
    <xsl:variable name="country" as="xs:string?"
      select="normalize-space(r:CountryCode)[. ne '']"/>
    <xsl:if test="exists($labels) or $country">
      <xsl:text> ;&#10;  dcterms:spatial [&#10;    a dcterms:Location</xsl:text>
      <xsl:for-each select="$labels">
        <xsl:text> ;&#10;    rdfs:label {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
      </xsl:for-each>
      <xsl:if test="$country">
        <xsl:text> ;&#10;    dcterms:identifier {ded:literal($country)}</xsl:text>
      </xsl:if>
      <xsl:text>&#10;  ]</xsl:text>
    </xsl:if>
  </xsl:template>

  <xsl:template match="r:TemporalCoverage" mode="dataset-temporal">
    <xsl:variable name="start" as="xs:string?"
      select="normalize-space((r:ReferenceDate/r:StartDate | r:ReferenceDate/r:SimpleDate)[1])[. ne '']"/>
    <xsl:variable name="end" as="xs:string?"
      select="normalize-space(r:ReferenceDate/r:EndDate)[. ne '']"/>
    <xsl:if test="$start">
      <xsl:text> ;&#10;  dcterms:temporal [&#10;    a dcterms:PeriodOfTime</xsl:text>
      <xsl:text> ;&#10;    dcat:startDate {ded:typed-year-or-date($start)}</xsl:text>
      <xsl:if test="$end">
        <xsl:text> ;&#10;    dcat:endDate {ded:typed-year-or-date($end)}</xsl:text>
      </xsl:if>
      <xsl:text>&#10;  ]</xsl:text>
    </xsl:if>
  </xsl:template>

  <xsl:template match="r:ContactInformation" mode="contact-point">
    <xsl:variable name="fn" as="xs:string?"
      select="normalize-space((
          r:IndividualName/r:FullName/r:String
        | r:IndividualName/r:String
        | r:OrganizationName/r:String
      )[1])[. ne '']"/>
    <xsl:variable name="email" as="xs:string?"
      select="normalize-space(r:Email)[. ne '']"/>
    <xsl:text> ;&#10;  dcat:contactPoint [&#10;    a vcard:Kind</xsl:text>
    <xsl:if test="$fn">
      <xsl:text> ;&#10;    vcard:fn {ded:literal($fn)}</xsl:text>
    </xsl:if>
    <xsl:if test="$email">
      <xsl:text> ;&#10;    vcard:hasEmail {ded:iri('mailto:' || $email)}</xsl:text>
    </xsl:if>
    <xsl:text>&#10;  ]</xsl:text>
  </xsl:template>

  <xsl:template match="r:Contributor" mode="contact-from-contributor">
    <xsl:variable name="names" as="element(r:String)*"
      select="r:ContributorName/r:String | r:OrganizationName/r:String"/>
    <xsl:if test="exists($names)">
      <xsl:text> ;&#10;  dcat:contactPoint [&#10;    a vcard:Kind</xsl:text>
      <xsl:for-each select="$names">
        <xsl:text> ;&#10;    vcard:fn {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
      </xsl:for-each>
      <xsl:text>&#10;  ]</xsl:text>
    </xsl:if>
  </xsl:template>

  <!-- ===================================================================== -->
  <!-- Distribution                                                          -->
  <!-- ===================================================================== -->

  <xsl:template match="pi:PhysicalInstance" mode="distribution">
    <xsl:variable name="dist-uri" as="xs:string"
      select="ded:resource-uri(r:URN, 'urn:dedicate:distribution:', .)"/>

    <xsl:text>{ded:iri($dist-uri)}&#10;</xsl:text>
    <xsl:text>  a dcat:Distribution</xsl:text>

    <xsl:for-each select="r:Citation/r:Title/r:String">
      <xsl:text> ;&#10;  dcterms:title {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>

    <xsl:for-each select="(
        r:DataFileIdentification
      | pi:DataFileIdentification
      | *[local-name() eq 'DataFileIdentification']
      )/*[local-name() eq 'DataFileURI'] ! normalize-space(.)[. ne '']">
      <xsl:variable name="uri" as="xs:string" select="
          if (matches(., '^(https?|urn|file):', 'i')) then .
          else if ($base-uri) then $base-uri || .
          else .
        "/>
      <xsl:text> ;&#10;  dcat:accessURL {ded:iri($uri)}</xsl:text>
    </xsl:for-each>

    <xsl:for-each select="r:Citation/r:Description/(r:Content | r:String)">
      <xsl:text> ;&#10;  dcterms:description {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>

    <xsl:for-each select="(
        r:Citation/(r:Format | *[local-name() = ('format', 'Format')])
      | r:Citation/r:DCTerms/*[local-name() eq 'format']
      ) ! normalize-space(.)[. ne '']">
      <xsl:text> ;&#10;  dcterms:format {ded:literal(.)}</xsl:text>
    </xsl:for-each>

    <xsl:text> .&#10;&#10;</xsl:text>
  </xsl:template>

  <!-- ===================================================================== -->
  <!-- Coding systems / code values (HealthDCAT-AP)                          -->
  <!-- ===================================================================== -->

  <xsl:template match="l:CodeList" mode="coding-system">
    <xsl:param name="root" as="document-node()"/>
    <xsl:variable name="cl-uri" as="xs:string"
      select="ded:resource-uri(r:URN, 'urn:dedicate:codelist:', .)"/>
    <xsl:variable name="id" as="xs:string?"
      select="normalize-space((r:UserID)[1])[. ne '']"/>

    <xsl:text>{ded:iri($cl-uri)}&#10;</xsl:text>
    <xsl:text>  a dcterms:Standard, skos:ConceptScheme</xsl:text>

    <xsl:if test="$id">
      <xsl:text> ;&#10;  dcterms:identifier {ded:literal($id)}</xsl:text>
    </xsl:if>

    <xsl:for-each select="r:Label/r:Content">
      <xsl:text> ;&#10;  dcterms:title {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
      <xsl:text> ;&#10;  skos:prefLabel {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>
    <xsl:if test="empty(r:Label/r:Content)">
      <xsl:for-each select="l:CodeListName/r:String">
        <xsl:text> ;&#10;  dcterms:title {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
        <xsl:text> ;&#10;  skos:prefLabel {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
      </xsl:for-each>
    </xsl:if>

    <xsl:text> .&#10;&#10;</xsl:text>

    <xsl:apply-templates select="l:Code" mode="code-value">
      <xsl:with-param name="root" select="$root"/>
      <xsl:with-param name="scheme-uri" select="$cl-uri"/>
    </xsl:apply-templates>
  </xsl:template>

  <xsl:template match="l:Code" mode="code-value">
    <xsl:param name="root" as="document-node()"/>
    <xsl:param name="scheme-uri" as="xs:string"/>
    <xsl:variable name="code-uri" as="xs:string"
      select="ded:resource-uri(r:URN, 'urn:dedicate:code:', .)"/>
    <xsl:variable name="notation" as="xs:string?"
      select="normalize-space(r:Value)[. ne '']"/>
    <xsl:variable name="category" as="element(l:Category)?"
      select="r:CategoryReference/r:URN
                ! normalize-space(.)
                ! key('by-urn', ., $root)[self::l:Category][1]"/>

    <xsl:text>{ded:iri($code-uri)}&#10;</xsl:text>
    <xsl:text>  a skos:Concept</xsl:text>
    <xsl:text> ;&#10;  skos:inScheme {ded:iri($scheme-uri)}</xsl:text>

    <xsl:if test="$notation">
      <xsl:text> ;&#10;  skos:notation {ded:literal($notation)}</xsl:text>
    </xsl:if>

    <xsl:for-each select="r:UserID ! normalize-space(.)[. ne '']">
      <xsl:text> ;&#10;  dcterms:identifier {ded:literal(.)}</xsl:text>
    </xsl:for-each>

    <xsl:for-each select="$category/r:Label/r:Content">
      <xsl:text> ;&#10;  skos:prefLabel {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>

    <xsl:text> .&#10;&#10;</xsl:text>
  </xsl:template>

  <!-- ===================================================================== -->
  <!-- Variables: one TableGroup per Dataset, Tables = LogicalRecords        -->
  <!-- ===================================================================== -->

  <xsl:template name="ded:emit-tablegroup">
    <xsl:param name="tablegroup-uri" as="xs:string"/>
    <xsl:param name="records" as="element(l:LogicalRecord)*"/>
    <xsl:param name="root" as="document-node()"/>
    <xsl:param name="title-strings" as="element(r:String)*"/>

    <xsl:text>{ded:iri($tablegroup-uri)}&#10;</xsl:text>
    <xsl:text>  a csvw:TableGroup</xsl:text>
    <xsl:for-each select="$title-strings">
      <xsl:text> ;&#10;  dcterms:title {ded:literal(normalize-space(.) || ' — variables', @xml:lang)}</xsl:text>
    </xsl:for-each>
    <xsl:for-each select="$records">
      <xsl:text> ;&#10;  csvw:table {
        ded:iri(ded:resource-uri(r:URN, 'urn:dedicate:table:', .))
      }</xsl:text>
    </xsl:for-each>
    <xsl:text> .&#10;&#10;</xsl:text>

    <xsl:apply-templates select="$records" mode="table">
      <xsl:with-param name="root" select="$root"/>
    </xsl:apply-templates>
  </xsl:template>

  <xsl:template match="l:LogicalRecord" mode="table">
    <xsl:param name="root" as="document-node()"/>
    <xsl:variable name="table-uri" as="xs:string"
      select="ded:resource-uri(r:URN, 'urn:dedicate:table:', .)"/>
    <xsl:variable name="variables" as="element(l:Variable)*"
      select="l:VariablesInRecord/l:VariableUsedReference/r:URN
                ! normalize-space(.)
                ! key('by-urn', ., $root)[self::l:Variable]"/>

    <xsl:text>{ded:iri($table-uri)}&#10;</xsl:text>
    <xsl:text>  a csvw:Table</xsl:text>

    <xsl:for-each select="l:LogicalRecordName/r:String">
      <xsl:text> ;&#10;  dcterms:title {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>

    <xsl:for-each select="$variables">
      <xsl:text> ;&#10;  csvw:column {
        ded:iri(ded:resource-uri(r:URN, 'urn:dedicate:column:', .))
      }</xsl:text>
    </xsl:for-each>

    <xsl:text> .&#10;&#10;</xsl:text>

    <xsl:apply-templates select="$variables" mode="column"/>
  </xsl:template>

  <xsl:template match="l:Variable" mode="column">
    <xsl:variable name="col-uri" as="xs:string"
      select="ded:resource-uri(r:URN, 'urn:dedicate:column:', .)"/>
    <xsl:variable name="name" as="xs:string?"
      select="normalize-space((l:VariableName/r:String)[1])[. ne '']"/>
    <xsl:variable name="datatype" as="xs:string?"
      select="ded:map-datatype(.)"/>

    <xsl:text>{ded:iri($col-uri)}&#10;</xsl:text>
    <xsl:text>  a csvw:Column</xsl:text>

    <xsl:if test="$name">
      <xsl:text> ;&#10;  csvw:name {ded:literal($name)}</xsl:text>
    </xsl:if>

    <xsl:for-each select="r:Label/r:Content">
      <xsl:text> ;&#10;  csvw:title {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>

    <xsl:for-each select="r:Description/r:Content">
      <xsl:text> ;&#10;  dcterms:description {ded:literal(normalize-space(.), @xml:lang)}</xsl:text>
    </xsl:for-each>

    <xsl:for-each select="r:UserID ! normalize-space(.)[. ne '']">
      <xsl:text> ;&#10;  dcterms:identifier {ded:literal(.)}</xsl:text>
    </xsl:for-each>

    <xsl:if test="$datatype">
      <xsl:text> ;&#10;  csvw:datatype {ded:literal($datatype)}</xsl:text>
    </xsl:if>

    <xsl:for-each select="r:ConceptReference[normalize-space(r:URN)][1]/r:URN ! normalize-space(.)">
      <xsl:text> ;&#10;  csvw:propertyUrl {ded:iri(.)}</xsl:text>
    </xsl:for-each>

    <xsl:text> .&#10;&#10;</xsl:text>
  </xsl:template>

  <!-- ===================================================================== -->
  <!-- Functions                                                             -->
  <!-- ===================================================================== -->

  <xsl:function name="ded:resource-uri" as="xs:string">
    <xsl:param name="urn" as="item()?"/>
    <xsl:param name="fallback-prefix" as="xs:string"/>
    <xsl:param name="node" as="node()"/>
    <xsl:sequence select="
        let $u := normalize-space(string(($urn, '')[1]))
        return if ($u) then $u else $fallback-prefix || generate-id($node)
      "/>
  </xsl:function>

  <xsl:function name="ded:iri" as="xs:string">
    <xsl:param name="uri" as="xs:string"/>
    <xsl:sequence select="'&lt;' || $uri || '&gt;'"/>
  </xsl:function>

  <xsl:function name="ded:turtle-escape" as="xs:string">
    <xsl:param name="text" as="xs:string?"/>
    <xsl:sequence select="
        replace(
          replace(
            replace(string(($text, '')[1]), '\\', '\\\\'),
            '&quot;', '\\&quot;'
          ),
          '&#10;', '\\n'
        )
      "/>
  </xsl:function>

  <xsl:function name="ded:literal" as="xs:string">
    <xsl:param name="text" as="xs:string?"/>
    <xsl:param name="lang" as="xs:string?"/>
    <xsl:sequence select="
        '&quot;' || ded:turtle-escape($text) || '&quot;'
        || (if (exists($lang) and normalize-space($lang))
            then '@' || normalize-space($lang)
            else '')
      "/>
  </xsl:function>

  <!-- One-arg overload for convenience -->
  <xsl:function name="ded:literal" as="xs:string">
    <xsl:param name="text" as="xs:string?"/>
    <xsl:sequence select="ded:literal($text, ())"/>
  </xsl:function>

  <!-- Returns a CSVW built-in name (e.g. string, integer), or empty if unknown -->
  <xsl:function name="ded:map-datatype" as="xs:string?">
    <xsl:param name="variable" as="element(l:Variable)"/>
    <xsl:variable name="rdt" as="xs:string?"
      select="normalize-space(($variable/l:VariableRepresentation//r:RecommendedDataType)[1])[. ne '']"/>
    <xsl:sequence select="
        if (exists($rdt) and map:contains($ded:datatype-map, $rdt))
        then $ded:datatype-map($rdt)
        else if ($variable/l:VariableRepresentation/r:TextRepresentation) then 'string'
        else if ($variable/l:VariableRepresentation/r:NumericRepresentation) then 'decimal'
        else if ($variable/l:VariableRepresentation/r:DateTimeRepresentation) then 'dateTime'
        else if ($variable/l:VariableRepresentation/r:CodeRepresentation) then 'string'
        else ()
      "/>
  </xsl:function>

  <!-- Year (YYYY) or date-like string → typed Turtle literal -->
  <xsl:function name="ded:typed-year-or-date" as="xs:string">
    <xsl:param name="value" as="xs:string"/>
    <xsl:sequence select="
        if (matches($value, '^\d{4}$'))
        then '&quot;' || $value || '&quot;^^xsd:gYear'
        else if (matches($value, '^\d{4}-\d{2}-\d{2}$'))
        then '&quot;' || $value || '&quot;^^xsd:date'
        else ded:literal($value)
      "/>
  </xsl:function>

  <!-- Catalogue-style "Label (https://…)" → embedded URI, else empty -->
  <xsl:function name="ded:embedded-uri" as="xs:string?">
    <xsl:param name="text" as="xs:string?"/>
    <xsl:variable name="t" as="xs:string"
      select="normalize-space(string(($text, '')[1]))"/>
    <xsl:sequence select="
        if (matches($t, '\(https?://[^)\s]+\)'))
        then replace($t, '^.*?\((https?://[^)\s]+)\).*$', '$1')
        else ()
      "/>
  </xsl:function>

  <!-- Dedupe key for dcterms passthrough (IRI object vs lang-tagged literal) -->
  <xsl:function name="ded:dcterms-object-key" as="xs:string">
    <xsl:param name="node" as="element()"/>
    <xsl:variable name="val" as="xs:string" select="normalize-space($node)"/>
    <xsl:variable name="embedded" as="xs:string?" select="ded:embedded-uri($val)"/>
    <xsl:sequence select="
        if (matches($val, '^(https?|urn):', 'i')) then lower-case($val)
        else if ($embedded) then lower-case($embedded)
        else $val || '|' || normalize-space($node/@xml:lang)
      "/>
  </xsl:function>

</xsl:stylesheet>
